{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/duel/(.+)",
      "destination": "/duel/index.html"
    },
    {
      "source": "/replay/(.+)",
      "destination": "/replay/index.html"
    },
    {
      "source": "/strategy/(.+)",
      "destination": "/strategy/index.html"
    },
    {
      "source": "/history/(.+)",
      "destination": "/history/index.html"
    },
    {
      "source": "/circuits/(.+)",
      "destination": "/circuits/index.html"
    },
    {
      "source": "/races/(.+)",
      "destination": "/races/index.html"
    },
    {
      "source": "/records/(.+)",
      "destination": "/records/index.html"
    },
    {
      "source": "/engines/(.+)",
      "destination": "/engines/index.html"
    },
    {
      "source": "/nations/(.+)",
      "destination": "/nations/index.html"
    },
    {
      "source": "/help/(.+)",
      "destination": "/help/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://api.web3forms.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
