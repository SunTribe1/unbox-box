# Copy to .env.local (or set in your host) and fill in what you use. All are optional.

# Where the app reads data. Unset: the bundled Monza 2025 demo in public/data.
# NEXT_PUBLIC_DATA_BASE=https://huggingface.co/datasets/<you>/unbox-box-data/resolve/main

# Help-page reports by email, free: enter your email at https://web3forms.com and paste the
# access key it sends you. The key is public by design; it can only send to your inbox.
# NEXT_PUBLIC_WEB3FORMS_KEY=

# Adds an "Open a GitHub issue" option to the report form.
# NEXT_PUBLIC_REPO_URL=https://github.com/<you>/unbox-box

# Chrome origin-trial token for WebMCP.
# NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL=

# The public URL, for link previews and the sitemap (Vercel is detected automatically).
# NEXT_PUBLIC_SITE_URL=https://unbox-box.example.org
