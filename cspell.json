{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB,en",
  "import": ["@cspell/dict-en-gb/cspell-ext.json"],
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./.cspell/project-words.txt", "addWords": true }
  ],
  "dictionaries": [
    "project-words",
    "typescript",
    "python",
    "css",
    "html",
    "npm",
    "softwareTerms",
    "companies",
    "fullstack"
  ],
  "ignorePaths": [
    "node_modules",
    ".next",
    "out",
    "coverage",
    "data",
    "apps/web/public/data",
    "apps/web/public/flags",
    "apps/web/public/THIRD_PARTY_NOTICES.txt",
    "pipeline/.venv",
    "pipeline/.cache",
    "package-lock.json",
    "pipeline/uv.lock",
    "**/*.svg",
    "docs/research/*.html",
    ".cspell"
  ],
  "ignoreRegExpList": [
    "/[A-Z]{3}-\\d+/g",
    "/\\b[A-Z]{2,4}\\b/g",
    "/oklch\\([^)]*\\)/g",
    "/#[0-9a-fA-F]{3,8}\\b/g",
    "/\\b[a-z0-9]+(?:-[a-z0-9]+){2,}\\b/g"
  ]
}
